NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://everdear_app:change_me@localhost:5432/everdear_dev?schema=public"
TEST_DATABASE_URL="postgresql://everdear_app:change_me@localhost:5432/everdear_test?schema=public"
SHADOW_DATABASE_URL="postgresql://everdear_app:change_me@localhost:5432/everdear_shadow?schema=public"

# Comma-separated origins are supported.
WEB_ORIGIN="http://localhost:3000"

# Keep 0 locally. Configure the exact proxy-hop count in production.
TRUST_PROXY_HOPS=0

AUTH_IP_HASH_SECRET=replace_with_at_least_32_random_characters
PUBLIC_WALL_HASH_SECRET=replace_with_at_least_32_random_characters

# Local development storage
MEDIA_STORAGE_DRIVER=local
MEDIA_STORAGE_ROOT=storage/media

# Production S3-compatible storage
# For Cloudflare R2, use region "auto".
# For AWS S3, leave S3_ENDPOINT empty and use the AWS region.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false