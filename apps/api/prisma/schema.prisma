generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum LetterType {
  LOVED
  FRIEND
  FAMILY
}

enum LetterStatus {
  DRAFT
  READY
  PUBLISHED
  REVOKED
  EXPIRED
}

enum AttachmentType {
  IMAGE
  VIDEO
}

enum AttachmentStatus {
  PENDING_UPLOAD
  PROCESSING
  READY
  FAILED
}

enum PublicMessageStatus {
  PENDING
  PUBLISHED
  HIDDEN
  REMOVED
  EXPIRED
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATEFUL_CONTENT
  SEXUAL_CONTENT
  PERSONAL_INFORMATION
  SELF_HARM
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTIONED
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(100)
  email           String    @unique @db.VarChar(320)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  role            UserRole  @default(USER)
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions        Session[]
  letters         Letter[]
  publicMessages  PublicMessage[]
  reportsMade     Report[]        @relation("ReportReporter")
  reportsResolved Report[]        @relation("ReportResolver")

  @@index([createdAt])
  @@map("users")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  userAgent  String?   @map("user_agent") @db.VarChar(512)
  ipHash     String?   @map("ip_hash") @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model Letter {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  type          LetterType
  status        LetterStatus @default(DRAFT)
  title         String?      @db.VarChar(160)
  recipientName String       @map("recipient_name") @db.VarChar(120)
  senderName    String       @map("sender_name") @db.VarChar(120)
  content       Json
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz(3)
  firstViewedAt DateTime?    @map("first_viewed_at") @db.Timestamptz(3)
  lastViewedAt  DateTime?    @map("last_viewed_at") @db.Timestamptz(3)
  viewCount     Int          @default(0) @map("view_count")
  expiresAt     DateTime?    @map("expires_at") @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments LetterAttachment[]
  shareLink   LetterLink?

  @@index([userId, status, updatedAt])
  @@index([status, expiresAt])
  @@map("letters")
}

model LetterAttachment {
  id              String           @id @default(uuid()) @db.Uuid
  letterId        String           @map("letter_id") @db.Uuid
  type            AttachmentType
  status          AttachmentStatus @default(PENDING_UPLOAD)
  storageKey      String           @unique @map("storage_key") @db.VarChar(500)
  thumbnailKey    String?          @map("thumbnail_key") @db.VarChar(500)
  originalName    String           @map("original_name") @db.VarChar(255)
  mimeType        String           @map("mime_type") @db.VarChar(120)
  sizeBytes       Int              @map("size_bytes")
  width           Int?
  height          Int?
  durationSeconds Int?             @map("duration_seconds")
  sortOrder       Int              @default(0) @map("sort_order")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  letter Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)

  @@index([letterId, sortOrder])
  @@index([letterId, type, status])
  @@map("letter_attachments")
}

model LetterLink {
  id             String    @id @default(uuid()) @db.Uuid
  letterId       String    @unique @map("letter_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.VarChar(128)
  tokenPrefix    String    @map("token_prefix") @db.VarChar(16)
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastAccessedAt DateTime? @map("last_accessed_at") @db.Timestamptz(3)
  accessCount    Int       @default(0) @map("access_count")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  letter Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("letter_links")
}

model PublicMessage {
  id              String              @id @default(uuid()) @db.Uuid
  userId          String?             @map("user_id") @db.Uuid
  content         String              @db.VarChar(500)
  displayLocation String?             @map("display_location") @db.VarChar(80)
  anonymous       Boolean             @default(true)
  authorHash      String?             @map("author_hash") @db.VarChar(128)
  status          PublicMessageStatus @default(PENDING)
  publishedAt     DateTime?           @map("published_at") @db.Timestamptz(3)
  expiresAt       DateTime?           @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  reports Report[]

  @@index([status, publishedAt])
  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("public_messages")
}

model Report {
  id             String       @id @default(uuid()) @db.Uuid
  messageId      String       @map("message_id") @db.Uuid
  reporterUserId String?      @map("reporter_user_id") @db.Uuid
  reporterHash   String?      @map("reporter_hash") @db.VarChar(128)
  reason         ReportReason
  details        String?      @db.VarChar(500)
  status         ReportStatus @default(PENDING)
  resolvedById   String?      @map("resolved_by_id") @db.Uuid
  resolvedAt     DateTime?    @map("resolved_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  message  PublicMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter User?         @relation("ReportReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  resolver User?         @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([messageId, reporterUserId])
  @@unique([messageId, reporterHash])
  @@index([messageId, status])
  @@index([status, createdAt])
  @@map("reports")
}
